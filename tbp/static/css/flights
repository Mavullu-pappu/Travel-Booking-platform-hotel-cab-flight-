
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f7fb;
    color: #333;
}

/* Navigation Bar */
header {
    background-color: #102a43;
    color: white;
    padding: 18px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #ffca28;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 25px;
    font-size: 16px;
}

nav a:hover,
nav a.active {
    color: #ffca28;
}

/* Hero Section */
.hero {
    min-height: 270px;
    background: linear-gradient(135deg, #1565c0, #102a43);
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    padding: 40px 20px;
}

.hero-content h1 {
    font-size: 42px;
    margin-bottom: 15px;
}

.hero-content p {
    font-size: 18px;
    line-height: 1.6;
}

/* Flight Booking Form */
.booking-section {
    width: 85%;
    max-width: 1150px;
    margin: -35px auto 55px;
    background-color: white;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
    position: relative;
}

.booking-section h2,
.destinations h2 {
    text-align: center;
    color: #102a43;
    font-size: 30px;
    margin-bottom: 12px;
}

.subtitle {
    text-align: center;
    color: #666;
    margin-bottom: 28px;
    line-height: 1.6;
}

/* Trip Type */
.trip-type {
    grid-column: 1 / -1;
    display: flex;
    gap: 25px;
    margin-bottom: 5px;
}

.trip-type label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
}

/* Form Layout */
.flight-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: bold;
    margin-bottom: 8px;
}

.form-group input,
.form-group select {
    width: 100%;
    padding: 13px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 15px;
    background-color: white;
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: #1565c0;
}

/* Search Button */
.search-btn {
    grid-column: 1 / -1;
    background-color: #1565c0;
    color: white;
    border: none;
    padding: 15px;
    border-radius: 6px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

.search-btn:hover {
    background-color: #0d47a1;
}

/* Popular Destinations */
.destinations {
    width: 85%;
    max-width: 1150px;
    margin: 0 auto 60px;
}

.destination-container {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    margin-top: 30px;
}

.destination-card {
    background-color: white;
    padding: 25px 18px;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s;
}

.destination-card:hover {
    transform: translateY(-6px);
}

.destination-icon {
    font-size: 48px;
    margin-bottom: 15px;
}

.destination-card h3 {
    color: #1565c0;
    margin-bottom: 12px;
    font-size: 21px;
}

.destination-card p {
    line-height: 1.6;
    color: #666;
}

/* Footer */
footer {
    background-color: #102a43;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Responsive Design */
@media (max-width: 900px) {
    .destination-container {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 18px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    nav a {
        margin-left: 0;
    }

    .hero-content h1 {
        font-size: 32px;
    }

    .booking-section,
    .destinations {
        width: 92%;
    }

    .booking-section {
        padding: 25px 18px;
    }

    .flight-form {
        grid-template-columns: 1fr;
    }

    .trip-type,
    .search-btn {
        grid-column: auto;
    }
}

@media (max-width: 480px) {
    .destination-container {
        grid-template-columns: 1fr;
    }

    .hero-content h1 {
        font-size: 28px;
    }
}
